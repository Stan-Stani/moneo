# ROMs — never committed (copyright + size). Loaded at runtime via Storage Access Framework picker.
*.gba
*.gb
*.gbc
*.sav
*.savestate

# Savestate fixtures pulled off-device for instrumentation tests (mirror app's slot_*.bin/.meta naming)
app/src/androidTest/assets/*.bin
app/src/androidTest/assets/*.meta

# Android / Gradle
.gradle/
build/
local.properties
.cxx/
*.iml
.idea/
captures/
.externalNativeBuild/

# Gradle wrapper jar tracked, but caches not
**/.gradle/

# macOS
.DS_Store

# Claude Code session state — per-machine, includes worktrees + telemetry
.claude/

# mGBA build artifacts (in case anything escapes the build/ dirs)
third_party/mgba/build/
.moneo-artifacts/

# Python venvs (mining/tooling)
.venv*/
__pycache__/

# Generated artifacts from font-hunt static analysis (large, regenerable)
tools/moneo/rom_swap/lz77_candidates_2024/
tools/moneo/rom_swap/lz77_renders/
tools/moneo/rom_swap/lz77_callers_2024.json
tools/moneo/rom_swap/lz77_sites_2024.json
tools/moneo/rom_swap/patched_lz77_blocks.csv
tools/moneo/rom_swap/diff_runs_2024.txt

# Generated HTML reports from visualizer scripts (rebuilt by the .py)
tools/moneo/rom_diff.html
tools/moneo/sentence_browser.html

# Local emulator save states for manual testing (see tools/test_states/README.md)
tools/test_states/**/*.bin
tools/test_states/**/*.meta
